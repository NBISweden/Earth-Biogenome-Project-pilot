// Resource allocations of the tools.
// Tools with a "Measured" comment: memory and time are proportional to the genome size of the sample
// (meta.sample.genome_size), at least the value measured on a 0.22 Gb genome (with a margin) and at
// most the value these tools had before for genomes over 3 Gb. See docs/development.md, "Resources".
// Tools without the comment are not measured yet and keep their earlier values.
// A task that is killed (out of memory or time) is retried with memory and time multiplied by the attempt.
process {
    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'terminate' }
    maxRetries    = 2

    // COMPARE_ASSEMBLIES
    withName: 'QUAST' {
        cpus       = { Math.min(6, consensus instanceof List ? consensus.size() : 1 ) }
    }

    // EVALUATE ASSEMBLIES
    // Measured, 0.22 Gb genome: peak 5.1 GB, 5.5 min, 7.5 cores
    withName: 'BUSCO' {
        time   = { ((Math.min(96d, Math.max(2d, 96d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 40 : 16 }
        memory = { ((Math.min(230d, Math.max(16d, 230d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).GB }
    }

    // FCS
    withName: 'FCSGX_FETCHDB' {
        time       = 2.d
    }

    withName: 'FCSGX_RUNGX' {
        // Limit to sequential execution so the database in memory safe from corruption by concurrent tasks.
        // RUNGX should run in less than an hour when using the ramdisk.
        maxForks   = 1
        cpus       = 20
        memory     = 600.GB
        time       = 1.h
    }

    // scaffolding - pairtools
    // parse runs single threaded but uses 3 decompression and 8 compression threads by default
    // the runtime heavily depends on the HiC file and potentially on IO-load

    withName: 'PAIRTOOLS' {
        time   = { meta.sample.genome_size.toLong() > 3000000000 ? 7.d : 2.d }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 32 : 16 }
        memory = { meta.sample.genome_size.toLong() > 3000000000 ? 230.GB : 128.GB }
    }

    withName: 'YAHS' {
        time   = { meta.sample.genome_size.toLong() > 3000000000 ? 12.h : 8.h }
        cpus   = 1
        memory = { meta.sample.genome_size.toLong() > 3000000000 ? 96.GB : 12.GB }
    }

    // Measured, 0.22 Gb genome: peak 34 GB on Hi-C (the data volume sets it), 3.5 h, under 1 core (I/O bound)
    withName: 'FASTK_FASTK' {
        time   = { ((Math.min(48d, Math.max(12d, 48d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 72 : 8 }
        memory = { ((Math.min(72d, Math.max(48d, 72d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).GB }
    }

    withName: 'FASTK_MERGE' {
        time   = { meta.sample.genome_size.toLong() > 3000000000 ? 1.d : 8.h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 72 : 36 }
        memory = { meta.sample.genome_size.toLong() > 3000000000 ? 96.GB : 30.GB }
    }

    // Measured, 0.22 Gb genome: fills the memory it gets (80 of 96 GB), 4 cores, 4.2 h on Hi-C. Memory kept, cpus lowered
    withName: 'MERYL_COUNT' {
        time   = { ((Math.min(48d, Math.max(12d, 48d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 72 : 8 }
        memory = { ((Math.min(288d, Math.max(96d, 288d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).GB }
    }
    // MERYL_UNIONSUM does not scale well with more threads
    // Measured, 0.22 Gb genome: peak 3.1 GB, 19 min, 1 core. Does not scale with more threads
    withName: 'MERYL_UNIONSUM' {
        time   = { ((Math.min(12d, Math.max(2d, 12d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 48 : 4 }
        memory = { ((Math.min(96d, Math.max(8d, 96d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).GB }
    }

    // Measured, 0.22 Gb genome: peak 2.6 GB, 19 min, 1.2 cores
    withName: 'MERQURY|MERQURY_INPUT_ASM|MERQURY_POLISHED_ASM' {
        time   = { ((Math.min(12d, Math.max(2d, 12d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 48 : 4 }
        memory = { ((Math.min(128d, Math.max(12d, 128d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).GB }
    }

    // Measured, 0.22 Gb genome: peak 4.1 GB, 4.4 min, 2.2 cores
    withName: 'MERQURYFK_MERQURYFK' {
        time   = { ((Math.min(8d, Math.max(1d, 8d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 64 : 6 }
        memory = { ((Math.min(96d, Math.max(12d, 96d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).GB }
    }

    withName: 'ITERATIVE_PURGEDUPS' {
        time   = { meta.sample.genome_size.toLong() > 3000000000 ? 1.d : 12.h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 64 : 32 }
        memory = { meta.sample.genome_size.toLong() > 3000000000 ? 64.GB : 32.GB }
    }

    withName: 'BWAMEM2_INDEX|BWAMEM2_INDEX_SCAFFOLD' {
        time   = { meta.sample.genome_size.toLong() > 3000000000 ? 1.d : 12.h }
        cpus   = 1
        memory = { meta.sample.genome_size.toLong() > 3000000000 ? 256.GB : 60.GB }
    }

    withName: 'BWAMEM2_MEM_SCAFFOLD|BWAMEM2_MEM_CURATION' {
        time   = { meta.sample.genome_size.toLong() > 3000000000 ? 1.d : 12.h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 96 : 64 }
        memory = { meta.sample.genome_size.toLong() > 3000000000 ? 596.GB : 120.GB }
    }

    // Measured, 0.22 Gb genome: peak 21.6 GB, 3.8 h, 14 of the 16 cores available
    withName: 'HIFIASM' {
        time   = { ((Math.min(48d, Math.max(12d, 48d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 96 : 46 }
        memory = { ((Math.min(596d, Math.max(48d, 596d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).GB }
    }

    // scales linearly with genome size
    // Measured, 0.22 Gb genome: peak 0.3 GB, 8 s
    withName: 'GFASTATS' {
        time   = { ((Math.min(4d, Math.max(1d, 4d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).h }
        cpus   = { meta.sample.genome_size.toLong() > 3000000000 ? 1 : 1 }
        memory = { ((Math.min(64d, Math.max(2d, 64d / 3d * (meta.sample.genome_size.toLong() / 1000000000d))) * task.attempt) as int).GB }
    }

    withName: 'SAMTOOLS_MERGE_(HIFI|HIC)' {
        cpus       = 8
        memory     = 10.GB
    }

    withName: 'BAM2BED_SORT' {
        memory     = 150.GB
    }

    withName: 'PRETEXTMAP' {
        memory     = 30.GB
    }

    // POLISH
    withName: 'DVPOLISH_PBMM2_ALIGN' {
        cpus = 20
    }
    withName: 'SAMTOOLS_VIEW' {
        cpus = 10
    }
    withName: 'DEEPVARIANT_RUNDEEPVARIANT' {
        cpus = 20
    }
    withName: 'BCFTOOLS_VIEW' {
        cpus = 6
    }
    withName: 'BCFTOOLS_MERGE' {
        cpus = 4
    }
}
