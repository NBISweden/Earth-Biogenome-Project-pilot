    // scaffolding curation

    // COMPARE_ASSEMBLIES

    // EVALUATE_ASSEMBLY

    // Processes that run in the workflow, not on a compute node
    withName: 'ENA_TAXQUERY|TOL_SEARCH|REPORT_GENOMETRAITS|WRITE_FILE' {
        executor = 'local'
    }
}
