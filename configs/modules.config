process {

    // PREPARE INPUT
    withName: 'ENA_TAXQUERY' {
        executor = 'local'
    }
    withName: 'SEQKIT_HIFI_STATS' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/seqkit_hifi_stats" },
            mode: params.publish_mode
        ]
    }
    withName: 'SEQKIT_HIC_STATS' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/seqkit_hic_stats" },
            mode: params.publish_mode
        ]
    }
    withName: 'FASTQC' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/fastqc_hic" },
            mode: params.publish_mode
        ]
    }
    withName: 'GOAT_TAXONSEARCH' {
        ext.args   = "--lineage --variables odb10_lineage,haploid_number,genome_size,ploidy"
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/goat" },
            mode: params.publish_mode
        ]
    }
    withName: 'PREPARE_INPUT:SAMTOOLS_FASTA' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.preprocess/converted_bam_to_fasta" },
            mode: params.publish_mode
        ]
    }


    withName: 'CONVERT_FASTQ_CRAM:SAMTOOLS_IMPORT' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.preprocess/hi-c_cram" },
            mode: params.publish_mode
        ]
    }
    withName: 'CONVERT_FASTQ_CRAM:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.preprocess/hi-c_cram" },
            mode: params.publish_mode
        ]
    }

    // BUILD FASTK DATABASES
    withName: 'BUILD_FASTK_HIFI_DATABASE:FASTK_FASTK' {
        scratch    = false  // !Disable scratch to get around bug https://github.com/nextflow-io/nextflow/issues/2983
    }
    withName: 'BUILD_FASTK_HIC_DATABASE:FASTK_FASTK' {
        scratch    = false  // !Disable scratch to get around bug https://github.com/nextflow-io/nextflow/issues/2983
    }
    withName: 'BUILD_FASTK_HIFI_DATABASE:FASTK_MERGE' {
        scratch    = false  // !Disable scratch to get around bug https://github.com/nextflow-io/nextflow/issues/2983
    }
    withName: 'BUILD_FASTK_HIC_DATABASE:FASTK_MERGE' {
        scratch    = false  // !Disable scratch to get around bug https://github.com/nextflow-io/nextflow/issues/2983
    }
    withName: '.*:FASTK_(FASTK|MERGE)' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/fastk" },
            mode: params.publish_mode
        ]
    }

    // GENOME PROPERTIES
    withName: 'GENESCOPEFK' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/genescopefk" },
            mode: params.publish_mode
        ]
    }
    withName: 'SMUDGEPLOT' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/smudgeplot" },
            mode: params.publish_mode
        ]
    }
    withName: 'MERQURYFK_KATGC' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/katgc" },
            mode: params.publish_mode
        ]
    }

    // COMPARE_LIBRARIES
    withName: 'MERQURYFK_KATCOMP' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/kat_comp" },
            mode: params.publish_mode
        ]
    }

    // ASSEMBLE_HIFI
    withName: 'HIFIASM' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.assembly/$meta.assembly.build" },
            mode: params.publish_mode
        ]
    }
    withName: 'GFATOOLS_GFA2FA' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.assembly/$meta.assembly.build" },
            mode: params.publish_mode
        ]
    }

    // ORGANELLE ASSEMBLY
    withName: 'MITOHIFI_FINDMITOREFERENCE' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.assembly/organelle/mitohifi/references" },
            mode: params.publish_mode
        ]
    }
    withName: 'MITOHIFI_MITOHIFI' {
        publishDir = [
            path: {
                [
                    params.outdir,
                    params.stage_dirs.assembly,
                    'organelle',
                    'mitohifi',
                    input_mode == 'c' ? meta.assembly.build : meta.id,
                ].minus("").join("/")
            },
            mode: params.publish_mode
        ]
    }
    withName: 'OATK' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.assembly/organelle/oatk" },
            mode: params.publish_mode
        ]
    }
    withName: 'DNADOTPLOT' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.assembly/organelle/dotplots" },
            mode: params.publish_mode
        ]
    }

    // DECONTAMINATE
    withName: 'FCSGX_FETCHDB' {
        storeDir = { params.cache }
    }
    withName: 'FCSGX_RUNGX' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.screen/fcsgx" },
            mode: params.publish_mode
        ]
    }
    withName: 'FCSGX_CLEAN' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.screen/fcsgx" },
            mode: params.publish_mode
        ]
    }

    // PURGE_DUPLICATES
    withName: 'ITERATIVE_PURGEDUPS' {
        publishDir                = [
            path: { "$params.outdir/$params.stage_dirs.purge/purge_dups" },
            mode: params.publish_mode
        ]
    }

    withName: 'STAR_ALIGN' {
        tag        = { meta.assembly.build }
        ext.args   = '--readFilesCommand zcat'
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.alignRNA/star/$meta.assembly.build" },
            mode: params.publish_mode
        ]
    }

    // POLISH
    withName: 'DVPOLISH_CREATE_FINALASM' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.polish/dvpolish/$meta.assembly.build" },
            mode: params.publish_mode
        ]
    }

    // SCAFFOLD
    withName: 'PAIRTOOLS' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.scaffold/pairtools/$meta.assembly.build" },
            mode: params.publish_mode,
            pattern: "*.stat"
        ]
    }
    withName: 'YAHS' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.scaffold/yahs/$meta.assembly.build" },
            mode: params.publish_mode
        ]
    }

    withName: 'MERGE_HAPLOTYPES' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.scaffold/merged_haps/$meta.assembly.build" },
            mode: params.publish_mode
        ]
    }

    // scaffolding curation
    withName: 'SCAFFOLD_CURATION:COOLER_ZOOMIFY' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.curate/higlass/$meta.assembly.build" },
            mode: params.publish_mode,
            pattern: "*.mcool"
        ]
    }
    withName: 'SCAFFOLD_CURATION:BAM2COVERAGE_TRACKS' {
        //TODO use task2
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.curate/higlass/$meta.assembly.build" },
            mode: params.publish_mode,
            pattern: "*.hitile"
        ]
    }
    withName: 'SCAFFOLD_CURATION:CREATE_GAP_TRACKS' {
        // ext.args   = { "" } // sort
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.curate/higlass/$meta.assembly.build" },
            mode: params.publish_mode,
            pattern: "*.beddb"
        ]
    }
    withName: 'SCAFFOLD_CURATION:CREATE_TELOMER_BIGWIG_TRACK' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.curate/higlass/$meta.assembly.build" },
            mode: params.publish_mode,
            pattern: "*.bw"
        ]
    }
    withName: 'SCAFFOLD_CURATION:PRETEXT_TRACKS_INGESTION' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.curate/pretext/$meta.assembly.build" },
            mode: params.publish_mode,
            pattern: "*_wTracks.pretext"
        ]
    }

    // COMPARE_ASSEMBLIES
    withName: 'QUAST' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.report/quast" },
            mode: params.publish_mode
        ]
    }

    // EVALUATE_ASSEMBLY
    withName: 'MERQURYFK_MERQURYFK' {
        publishDir = [
            path: {
                [
                    params.outdir,
                    meta.assembly.stage == "raw" ? params.stage_dirs.assembly : '',
                    meta.assembly.stage == "decontaminated" ? params.stage_dirs.screen : '',
                    meta.assembly.stage == "purged" ? params.stage_dirs.purge : '',
                    meta.assembly.stage == "polished" ? params.stage_dirs.polish : '',
                    meta.assembly.stage == "scaffolded" ? params.stage_dirs.scaffold : '',
                    meta.assembly.stage == "curated" ? params.stage_dirs.curate : '',
                    "merquryfk",
                    meta.assembly.build,
                ].minus("").join("/")
            },
            mode: params.publish_mode
        ]
    }
    withName: 'MERQURY_MERQURY' {
        tag        = { meta.assembly.build }
        ext.prefix = { "${meta.assembly.build}_merqury" }
        publishDir = [
            path: {
                [
                    params.outdir,
                    meta.assembly.stage == "raw" ? params.stage_dirs.assembly : '',
                    meta.assembly.stage == "decontaminated" ? params.stage_dirs.screen : '',
                    meta.assembly.stage == "purged" ? params.stage_dirs.purge : '',
                    meta.assembly.stage == "polished" ? params.stage_dirs.polish : '',
                    meta.assembly.stage == "scaffolded" ? params.stage_dirs.scaffold : '',
                    meta.assembly.stage == "curated" ? params.stage_dirs.curate : '',
                    "merqury",
                    meta.assembly.build,
                ].minus("").join("/")
            },
            mode: params.publish_mode
        ]
    }
    withName: 'BUSCO' {
        publishDir = [
            path: {
                [
                    params.outdir,
                    meta.assembly.stage == "raw" ? params.stage_dirs.assembly : '',
                    meta.assembly.stage == "decontaminated" ? params.stage_dirs.screen : '',
                    meta.assembly.stage == "purged" ? params.stage_dirs.purge : '',
                    meta.assembly.stage == "polished" ? params.stage_dirs.polish : '',
                    meta.assembly.stage == "scaffolded" ? params.stage_dirs.scaffold : '',
                    meta.assembly.stage == "curated" ? params.stage_dirs.curate : '',
                    "busco",
                    meta.assembly.build,
                ].minus("").join("/")
            },
            mode: params.publish_mode,
            pattern: "*.{txt,json}"
        ]
    }
    withName: 'GFASTATS' {
        publishDir = [
            path: {
                [
                    params.outdir,
                    meta.assembly.stage == "raw" ? params.stage_dirs.assembly : '',
                    meta.assembly.stage == "decontaminated" ? params.stage_dirs.screen : '',
                    meta.assembly.stage == "purged" ? params.stage_dirs.purge : '',
                    meta.assembly.stage == "polished" ? params.stage_dirs.polish : '',
                    meta.assembly.stage == "scaffolded" ? params.stage_dirs.scaffold : '',
                    meta.assembly.stage == "curated" ? params.stage_dirs.curate : '',
                    "gfastats",
                    meta.assembly.build,
                ].minus("").join("/")
            },
            mode: params.publish_mode
        ]
    }

    // Assembly report
    withName: 'TOL_SEARCH' {
        executor = 'local'
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.inspect/dtol_search" },
            mode: params.publish_mode
        ]
    }
    withName: 'REPORT_DTOL' {
        executor = 'local'
    }
    withName: 'REPORT_GENOMETRAITS' {
        executor = 'local'
    }
    withName: 'ASSEMBLY_REPORT:QUARTO_NOTEBOOK' {
        publishDir = [
            path: { "$params.outdir/$params.stage_dirs.report" },
            mode: params.publish_mode,
            overwrite: true
        ]
    }
}
