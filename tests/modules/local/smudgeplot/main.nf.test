nextflow_process {

    name "Test Process SMUDGEPLOT"
    script "../../../../modules/local/smudgeplot/main.nf"
    process "SMUDGEPLOT"

    tag "modules"
    tag "modules_local"
    tag "smudgeplot"

    test("smudgeplot - stub") {
        options "-stub-run"

        when {
            process {
                """
                input[0] = record(
                    id: 'test',
                    meta: null,
                    fastk_ktab: [ file("\$projectDir/tests/data/modules/seq.fasta") ],
                    smudgeplot_threshold: 10,
                    output_prefix: 'test'
                )
                """
            }
        }

        then {
            assert process.success
            def out = process.out[0][0]
            def names = { v -> [v].flatten().collect { f -> new File(f.toString()).name }.sort() }
            assert names(out.annotated_kmer_pairs_tsv) == ['test.sma']
            assert names(out.smudgeplot) == ['test_smudgeplot.png']
            assert names(out.smudgeplot_report_json) == ['test_smudgeplot_report.json']
        }
    }
}
