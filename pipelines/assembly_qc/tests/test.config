// Test config - Tiny dataset
params {
    outdir       = 'results'
    publish_mode = 'symlink'
}

process {
    cpus   = 1
    memory = 6.GB
    time   = 10.m
    resourceLimits = [
        cpus: 10,
        memory: 32.GB,
        time: 1.h
    ]

    withLabel: process_low {
        cpus   = 2
        memory = 6.GB
        time   = 10.m
    }
    withLabel: process_medium {
        cpus   = 6
        memory = 12.GB
        time   = 30.m
    }
    withLabel: process_high {
        cpus   = 10
        memory = 32.GB
        time   = 1.h
    }
}
